{
  "version": 2,
  "functions": {
    "api/generate.py": {
      "maxDuration": 120
    },
    "api/warmup.py": {
      "maxDuration": 15
    }
  },
  "routes": [
    { "src": "/api/generate", "dest": "/api/generate.py" },
    { "src": "/api/warmup", "dest": "/api/warmup.py" },
    { "src": "/generate-page", "dest": "/Main.html" },
    { "src": "/", "dest": "/index.html" },
    { "src": "/(.*)", "dest": "/$1" }
  ],
  "regions": ["iad1"]
}
