{
  "version": 2,
  "builds": [
    {
      "src": "api/generate.py",
      "use": "@vercel/python",
      "config": { "maxDuration": 120 }
    },
    {
      "src": "api/warmup.py",
      "use": "@vercel/python",
      "config": { "maxDuration": 15 }
    }
  ],
  "routes": [
    { "src": "/api/generate", "dest": "/api/generate.py" },
    { "src": "/api/warmup", "dest": "/api/warmup.py" },
    { "src": "/generate-page", "dest": "/Main.html" },
    { "src": "/", "dest": "/index.html" },
    { "src": "/(.*)", "dest": "/$1" }
  ],
  "regions": ["iad1"]
}
