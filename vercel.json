{
  "version": 2,
  "functions": {
    "api/generate.py": {
      "maxDuration": 120
    },
    "api/warmup.py": {
      "maxDuration": 15
    }
  },
  "builds": [
    { "src": "api/generate.py", "use": "@vercel/python" },
    { "src": "api/warmup.py", "use": "@vercel/python" },
    { "src": "*.html", "use": "@vercel/static" },
    { "src": "*.css", "use": "@vercel/static" },
    { "src": "*.js", "use": "@vercel/static" },
    { "src": "Images/**", "use": "@vercel/static" },
    { "src": "data/**", "use": "@vercel/static" },
    { "src": "assets/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/generate", "dest": "/api/generate.py" },
    { "src": "/api/warmup", "dest": "/api/warmup.py" },
    { "src": "/generate-page", "dest": "/Main.html" },
    { "src": "/", "dest": "/index.html" },
    { "src": "/(.*)", "dest": "/$1" }
  ],
  "regions": ["iad1"]
}
